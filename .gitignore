# ===== secrets — NEVER commit =====
.env
*.env
!.env.example
*.key
*.pem
*_private.key
.jwt_secret
# WireGuard / camera client configs — contain private keys
*.conf
# your real config with camera credentials (commit the .example instead)
go2rtc.yaml
go2rtc/

# ===== runtime data / recordings =====
*.db
*.db-shm
*.db-wal
frigate/
ntfy/
ntfy-cache/
storage/
clips/
recordings/
model_cache/
*.mp4
*.webp

# ===== python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== tooling / editor =====
.gstack/
.DS_Store
.idea/
.vscode/

# ===== vision module — NEVER commit your baby's data or trained model =====
# Weights are fine-tuned on YOUR baby's footage — treat like private data.
*.pt
*.onnx
*.engine
# Captured frames, annotations, datasets, alerts — all contain real baby images.
vision/**/frames/
vision/**/labels/
vision/**/prelabels/
vision/**/dataset/
vision/**/alerts/
vision/**/annotated/
vision/**/runs/
# Runtime state / overlay data written by the detector.
vision/**/boxes.json
vision/**/zone.json
vision/**/control.json
# Block all images by default (they'd be baby photos)...
*.jpg
*.jpeg
*.png
# ...but DO keep documentation images (add explicitly, or they stay ignored).
!vision/docs/*.png
!docs/*.png
!ha-addon/crywatch_cry_detector/icon.png
!ha-addon/crywatch_cry_detector/logo.png
