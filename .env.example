# Copy to .env and fill in your values. NEVER commit .env (it's gitignored).

# --- ntfy push (server-side cry alerts) — OPTIONAL (fork) ---
# Laisser vide pour désactiver ntfy complètement (le fork n'en dépend plus).
NTFY_URL=
# URL opened when you tap the notification (your viewer page).
CRY_CLICK_URL=http://YOUR_HOST:1985/multi.html

# --- MQTT push vers Home Assistant (FORK) ---
# Laisser MQTT_HOST vide pour désactiver. Pointer vers ton broker Mosquitto existant
# (pas celui du docker-compose — il n'y en a pas ici, tu utilises le tien).
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Préfixe des topics : crywatch/<slug>/state, crywatch/<slug>/attributes, crywatch/status
MQTT_TOPIC_BASE=crywatch
# 1 = publie la config HA MQTT discovery -> le binary_sensor apparaît tout seul dans HA
MQTT_DISCOVERY=1
# Durée (s) avant retour automatique à OFF si aucun nouveau pleur détecté.
# Aligné sur la fenêtre d'affichage Fully Kiosk (1 min).
CRY_STATE_TIMEOUT=60

# --- audio source ---
# go2rtc RTSP base the detector pulls audio from.
GO2RTC_RTSP=rtsp://YOUR_GO2RTC_HOST:8554
# Cameras to monitor: stream=Label,stream=Label
# (stream names must match the ones in your go2rtc config)
CAMS=simon=Chambre Simon

# --- detection tuning ---
CRY_PROB=0.4            # cry probability 0..1 to trigger (raise if false alarms)
CRY_SUSTAIN_SAMPLES=2   # consecutive loud-enough cry samples before alerting
CRY_COOLDOWN=60         # min seconds between alerts
CRY_LOG=1               # 1 = print every classification (handy for calibration)
