# Copy to .env and fill in your values. NEVER commit .env (it's gitignored).

# --- ntfy push (server-side cry alerts) ---
# Your self-hosted ntfy topic URL (or ntfy.sh/<topic>).
NTFY_URL=http://YOUR_NTFY_HOST:8095/YOUR_TOPIC
# URL opened when you tap the notification (your viewer page).
CRY_CLICK_URL=http://YOUR_HOST:1985/multi.html

# --- audio source ---
# go2rtc RTSP base the detector pulls audio from.
GO2RTC_RTSP=rtsp://YOUR_GO2RTC_HOST:8554
# Cameras to monitor: stream=Label,stream=Label
# (stream names must match the ones in your go2rtc config)
CAMS=cam1=Room 1,cam2=Room 2

# --- detection tuning ---
CRY_PROB=0.4            # cry probability 0..1 to trigger (raise if false alarms)
CRY_SUSTAIN_SAMPLES=2   # consecutive loud-enough cry samples before alerting
CRY_COOLDOWN=60         # min seconds between alerts
CRY_LOG=1               # 1 = print every classification (handy for calibration)
