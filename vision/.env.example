# Copy to .env and fill in your values. NEVER commit .env (it's gitignored).
# These configure the presence detector (detector/presence_detector.py).

# --- source & model ---
STREAM=cam2                       # go2rtc stream name of the sleeping-baby camera
LABEL=Baby                        # shown in push notifications
GO2RTC=http://localhost:1984      # go2rtc HTTP API (snapshot endpoint)
# Your fine-tuned model. If unset and no baby.pt is present, falls back to stock
# yolo11s.pt (works in daylight, mostly fails at night — train your own!).
MODEL=/app/baby.pt

# --- detection tuning ---
CONF=0.5                          # display / strong-detection threshold
POLL_SEC=2                        # seconds between snapshots
ABSENT_SEC=90                     # seconds of "not detected" before alerting
COOLDOWN=600                      # min seconds between absent-alerts
PRESENCE_LOG=0                    # 1 = print every poll (handy for calibration)

# --- push (ntfy) ---
NTFY_URL=http://YOUR_NTFY_HOST:8095/YOUR_TOPIC
CLICK_URL=http://YOUR_HOST:1985/multi.html   # opened when you tap the notification

# --- viewer overlay ---
# Where to write the red-box overlay data the web viewer reads. Point this at a file
# your viewer can serve (e.g. mount it into the viewer's web root as boxes.json).
BOXES_JSON=/app/boxes.json

# --- control API (arm/disarm + zone), read by the viewer's navbar buttons ---
CONTROL_PORT=1986

# --- motion ("baby is moving") ---
MOTION_FRAC=0.08                  # in-crib changed-pixel fraction to call it "moving"

# --- active learning (auto-collect the model's misses to retrain on) ---
HARD_COLLECT=1                    # 1 = save missed-but-present frames to frames/hard/
